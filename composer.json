{
    "name": "rockschtar/soccr",
    "type": "wordpress-plugin",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Rockschtar\\WordPress\\Soccr\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rockschtar\\WordPress\\Soccr\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",
        "phpunit/phpunit": "^12",
        "brain/monkey": "^2.6",
        "friendsofphp/php-cs-fixer": "^3.75"
    },
    "scripts": {
        "phpunit": "phpunit",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    },
    "authors": [
        {
            "name": "Stefan Helmer"
        }
    ],
    "require": {
        "php": ">=8.4"
    }
}
