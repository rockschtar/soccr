{
    "name": "rockschtar/soccr",
    "type": "wordpress-plugin",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Rockschtar\\WordPress\\Soccr\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rockschtar\\WordPress\\Soccr\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",
        "squizlabs/php_codesniffer": "^3.5.8",
        "phpunit/phpunit": "^11",
        "brain/monkey": "^2.6"
    },
    "scripts": {
        "phpunit": "phpunit",
        "phpcs": "phpcs"
    },
    "authors": [
        {
            "name": "Stefan Helmer"
        }
    ],
    "require": {
        "php": ">=8.4"
    }
}
