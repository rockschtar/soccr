#. Plugin Name of the plugin
#: soccr.php
#: src/Controller/BlockEditorController.php:48
msgid "Soccr"
msgstr "Soccr"

#. Plugin URI of the plugin
#: soccr.php
msgid "https://wordpress.org/plugins/soccr/"
